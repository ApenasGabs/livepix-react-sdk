# ---------------------------------------------------------------------------
# Variáveis PÚBLICAS (prefixo VITE_) — vão para o bundle do navegador.
# NUNCA coloque segredos aqui. O dev server aborta se detectar VITE_*SECRET*.
# ---------------------------------------------------------------------------
# Modo público: username do criador (https://livepix.gg/<username>)
VITE_LIVEPIX_USERNAME=apenasgabs
# Modo BFF: endpoint do seu backend que cria pagamentos (POST)
VITE_LIVEPIX_PAYMENT_ENDPOINT=/bff/payments

# ---------------------------------------------------------------------------
# Variáveis PRIVADAS (sem prefixo) — lidas apenas pelo BFF de desenvolvimento
# (plugin `livepix-dev-bff` em vite.config.js), nunca enviadas ao navegador.
# ---------------------------------------------------------------------------
LIVEPIX_CLIENT_ID=seu_client_id_aqui
LIVEPIX_CLIENT_SECRET=seu_client_secret_aqui
